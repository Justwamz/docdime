generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  PAY_PER_USE
  PRO
}

enum DocumentType {
  INVOICE
  QUOTE
  PURCHASE_ORDER
}

enum DocumentStatus {
  DRAFT
  SENT
  PAID
  ACCEPTED
  REJECTED
  CANCELLED
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String?
  businessName      String?
  businessEmail     String?
  businessPhone     String?
  businessAddress   String?
  businessLogo      String?
  country           String    @default("US")
  currency          String    @default("USD")
  plan              Plan      @default(PAY_PER_USE)
  isAdmin           Boolean   @default(false)
  consentGiven      Boolean   @default(false)
  onboardingDone    Boolean   @default(false)
  proExpiresAt      DateTime?
  docsThisMonth     Int       @default(0)
  lastDocReset      DateTime  @default(now())
  bankingDetails    Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  documents         Document[]
  customers         Customer[]
  taxes             Tax[]
  taxGroups         TaxGroup[]
  transactions      Transaction[]
  pushSubscriptions PushSubscription[]
}

model Customer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
}

model Tax {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  rate          Float
  isDefault     Boolean        @default(false)
  isInclusive   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  taxGroupItems TaxGroupItem[]
}

model Document {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  type            DocumentType
  status          DocumentStatus @default(DRAFT)
  docNumber       String
  issueDate       DateTime       @default(now())
  dueDate         DateTime?
  expiryDate      DateTime?
  notes           String?
  terms           String?
  subtotal        Float          @default(0)
  taxAmount       Float          @default(0)
  total           Float          @default(0)
  currency        String         @default("USD")
  pdfUrl          String?
  paid            Boolean        @default(false)
  convertedFromId  String?
  convertedToId    String?
  verificationCode String?        @unique @default(cuid())
  lineItems        LineItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  transactions Transaction[]
  verification DocumentVerification?
}

model LineItem {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float    @default(0)
  taxRate      Float    @default(0)
  appliedTaxes Json?
  total        Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId      String?
  document        Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  paystackRef     String?           @unique
  amount          Float
  currency        String            @default("USD")
  status          TransactionStatus @default(PENDING)
  type            String            @default("DOC_GENERATION")
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model DocumentVerification {
  id             String    @id @default(cuid())
  documentId     String    @unique
  verifiedCount  Int       @default(0)
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  logs           VerificationLog[]
}

model VerificationLog {
  id             String               @id @default(cuid())
  verificationId String
  ip             String?
  userAgent      String?
  verifiedAt     DateTime             @default(now())
  verification   DocumentVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  subject   String
  body      String
  variables String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model TaxGroup {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  isDefault  Boolean        @default(false)
  isCompound Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  items      TaxGroupItem[]
}

model TaxGroupItem {
  id        String    @id @default(cuid())
  groupId   String
  group     TaxGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  taxId     String
  tax       Tax       @relation(fields: [taxId], references: [id], onDelete: Restrict)
  order     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([groupId, order])
  @@unique([groupId, taxId])
}
